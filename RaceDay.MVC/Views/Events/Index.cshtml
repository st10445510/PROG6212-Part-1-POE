@model List<RaceDay.MVC.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Race Events";
    var role = Context.Session.GetString("Role");
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>RaceDay Events</h2>
            <p class="text-muted">Discover upcoming running, walking and cycling events.</p>
        </div>

        @if (role == "Organiser")
        {
            <a asp-action="Create" class="btn btn-dark">
                + Create Event
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@item.EventName</h5>

                            <p class="text-muted">
                                @(item.EventType ?? "Race Event")
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @(item.Distance.HasValue? item.Distance + " km" : "Not specified")
                            </p>

                            <p>@item.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
