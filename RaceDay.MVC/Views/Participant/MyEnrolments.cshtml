@model List<System.Text.Json.JsonElement>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-4">
    <h2>My Enrolments</h2>
    <p>View the events and categories you have enrolled in.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not enrolled in any categories yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.GetProperty("enrolmentId").GetInt32()</td>
                            <td>@item.GetProperty("categoryName").GetString()</td>
                            <td>@item.GetProperty("enrolmentDate").ToString()</td>
                            <td>@item.GetProperty("status").GetString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>