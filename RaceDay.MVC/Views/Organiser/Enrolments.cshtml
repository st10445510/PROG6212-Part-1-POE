@model List<System.Text.Json.JsonElement>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-4">
    <h2>Manage Participant Enrolments</h2>
    <p>View participant enrolments and update their status.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No participant enrolments found.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Enrolment ID</th>
                    <th>Participant ID</th>
                    <th>Category</th>
                    <th>Enrolment Date</th>
                    <th>Status</th>
                    <th>Update Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.GetProperty("enrolmentId").GetInt32()</td>
                        <td>@item.GetProperty("participantId").GetInt32()</td>
                        <td>@item.GetProperty("categoryName").GetString()</td>
                        <td>@item.GetProperty("enrolmentDate").ToString()</td>
                        <td>@item.GetProperty("status").GetString()</td>
                        <td>
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id"
                                       value="@item.GetProperty("enrolmentId").GetInt32()" />

                                <select name="status" class="form-select mb-2">
                                    <option value="Pending">Pending</option>
                                    <option value="Confirmed">Confirmed</option>
                                    <option value="Cancelled">Cancelled</option>
                                </select>

                                <button type="submit" class="btn btn-primary btn-sm">
                                    Update
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
